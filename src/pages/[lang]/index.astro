---
import Base from "../../layouts/Base.astro";
import PhantomMap from "../../components/PhantomMap.astro";
import { ui, LANGS, other, type Lang } from "../../i18n/ui";
import { url } from "../../lib/hosts.mjs";
import { storyCount } from "../../lib/atlas";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
// The number of stories, not of islands written about: several stories
// cover two islands, and the islands not yet written make a meaningless
// denominator.
const n = await storyCount(lang);
---

<Base lang={lang} altHref={url(other(lang), "/", lang)}>
  <PhantomMap lang={lang} />
  <p class="pmap-foot sc">
    <a href={url(lang, "/liste/")}>{n} {n === 1 ? t.story : t.stories}</a>
  </p>
</Base>
