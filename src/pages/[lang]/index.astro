---
import Base from "../../layouts/Base.astro";
import PhantomMap from "../../components/PhantomMap.astro";
import { ui, LANGS, type Lang } from "../../i18n/ui";
import { resolveIslands } from "../../lib/atlas";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const islands = await resolveIslands(lang);
const written = islands.filter((i) => i.state !== "planned").length;
---

<Base lang={lang} altHref={`/${lang === "fr" ? "en" : "fr"}/`}>
  <PhantomMap lang={lang} />
  <p class="pmap-foot sc">
    <span class="counter">{written} / {islands.length} {t.written}</span>
    {" · "}
    <a href={`/${lang}/liste/`}>{t.list}</a>
  </p>
</Base>
