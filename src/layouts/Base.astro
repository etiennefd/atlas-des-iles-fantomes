---
import "../styles/tokens.css";
import { ui, other, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  /** Path on the other language site, if a counterpart exists. */
  altHref?: string;
}
const { lang, title, altHref } = Astro.props;
const t = ui[lang];
const o = other(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${t.siteTitle}` : t.siteTitle}</title>
    <!-- Piazzolla is self-hosted (public/fonts, scripts/build_fonts.py); the
         roman is on every page, so it is fetched before the CSS asks. -->
    <link
      rel="preload"
      href="/fonts/piazzolla-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {altHref && <link rel="alternate" hreflang={o} href={altHref} />}
  </head>
  <body>
    <header class="masthead">
      <p class="masthead__title">
        <a href={`/${lang}/`}>{t.siteTitle}</a>
      </p>
      <nav class="sc">
        <a href={`/${lang}/liste/`}>{t.list}</a>
        {" · "}
        <a href={altHref ?? `/${o}/`} data-lang-switch>{t.otherLang}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
