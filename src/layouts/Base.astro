---
import "../styles/tokens.css";
import { ui, other, type Lang } from "../i18n/ui";
import { url } from "../lib/hosts.mjs";

interface Props {
  lang: Lang;
  title?: string;
  /** URL on the other language site (from url() in lib/hosts.mjs), if a
   *  counterpart exists. */
  altHref?: string;
}
const { lang, title, altHref } = Astro.props;
const t = ui[lang];
const o = other(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${t.siteTitle}` : t.siteTitle}</title>
    <!-- Piazzolla is self-hosted (public/fonts, scripts/build_fonts.py); the
         roman is on every page, so it is fetched before the CSS asks. -->
    <link
      rel="preload"
      href="/fonts/piazzolla-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Antillia (Canepa 1489) in water colour on a burgundy tile. The .ico
         is a 32 px PNG for browsers that ask for /favicon.ico regardless. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {altHref && <link rel="alternate" hreflang={o} href={altHref} />}
  </head>
  <body>
    <header class="masthead">
      <p class="masthead__title">
        <a href={url(lang, "/")}>{t.siteTitle}</a>
      </p>
      <nav class="sc">
        <a href={url(lang, "/liste/")}>{t.list}</a>
        {" // "}
        <a href={altHref ?? url(o, "/", lang)} data-lang-switch>{t.otherLang}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
