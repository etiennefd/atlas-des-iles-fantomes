---
import Base from "../../layouts/Base.astro";
import { ui, LANGS, type Lang } from "../../i18n/ui";
import { resolveIslands, lifespan } from "../../lib/atlas";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const islands = await resolveIslands(lang);
const written = islands.filter((i) => i.state !== "planned").length;
---

<Base lang={lang} title={t.list} altHref={`/${lang === "fr" ? "en" : "fr"}/liste/`}>
  <div class="list">
    <h1>{t.list}</h1>
    <p class="sc counter">{written} / {islands.length} {t.written}</p>
    <ol>
      {islands.map((i) => (
        <li data-state={i.state}>
          <span>
            {i.href ? <a href={i.href}>{i.name}</a> : i.name}
            {i.state === "planned" && <span class="sc"> — {t.forthcoming}</span>}
          </span>
          <span class="list__span sc">{lifespan(i.island)}</span>
        </li>
      ))}
    </ol>
  </div>
</Base>
