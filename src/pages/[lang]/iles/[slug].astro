---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import Base from "../../../layouts/Base.astro";
import { ui, other, type Lang } from "../../../i18n/ui";
import { splitStoryId, lifespan } from "../../../lib/atlas";
import { frenchSpacing } from "../../../lib/typo.mjs";

export async function getStaticPaths() {
  const stories = await getCollection("stories");
  const pages = stories.map((story) => {
    const { lang, slug } = splitStoryId(story.id);
    return { params: { lang, slug }, props: { story, placeholder: false } };
  });
  // A story written in one language only gets a placeholder page in the
  // other, at the URL its translation will have, so the language switch on
  // a story always lands on the same island. Drafts get none.
  for (const story of stories) {
    if (story.data.draft) continue;
    const { lang, slug } = splitStoryId(story.id);
    const o = other(lang);
    const translated = stories.some(
      (s) =>
        splitStoryId(s.id).lang === o &&
        s.data.islands.some((id) => story.data.islands.includes(id))
    );
    if (!translated) {
      pages.push({ params: { lang: o, slug }, props: { story, placeholder: true } });
    }
  }
  return pages;
}

// On a placeholder, `story` is the one in the other language.
const { story, placeholder } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const o = other(lang);

const islands = await getCollection("islands");
const covered = story.data.islands
  .map((id) => islands.find((i) => i.id === id))
  .filter(Boolean);

// A placeholder is titled by its islands, named in this language.
const title = placeholder
  ? covered
      .map((i) => (lang === "fr" ? i!.data.name_fr : i!.data.name_en))
      .join(lang === "fr" ? " et " : " and ")
  : story.data.title;

// The signature: each island's lifespan, joined when a story covers several.
const spans = covered
  .map((i) => {
    const s = lifespan(i!);
    return covered.length > 1 && s
      ? `${lang === "fr" ? i!.data.name_fr : i!.data.name_en}, ${s}`
      : s;
  })
  .filter(Boolean);

// Does a counterpart exist in the other language?
const stories = await getCollection("stories");
const counterpart = stories.find((s) => {
  const p = splitStoryId(s.id);
  return (
    p.lang === o && s.data.islands.some((id) => story.data.islands.includes(id))
  );
});
// With no counterpart, the other language has this story's placeholder.
const altHref = counterpart
  ? `/${o}/iles/${splitStoryId(counterpart.id).slug}/`
  : story.data.draft
    ? undefined
    : `/${o}/iles/${splitStoryId(story.id).slug}/`;

// A plate named in frontmatter but absent from public/ would render as a
// broken-image icon. Skip it, and say so at build time, so the gap stays
// visible to whoever builds rather than to whoever reads.
const images = story.data.images.filter((img) => {
  if (!img.src.startsWith("/")) return true;
  const ok = existsSync(join(process.cwd(), "public", img.src));
  if (!ok) console.warn(`[stories] ${story.id}: missing image ${img.src}, figure skipped`);
  return ok;
});

const { Content } = await render(story);
// Notice and caption markdown never contains " :" or "« " inside a URL, so the
// spacing can be applied to the source before it is parsed.
const spaced = (md: string) => (lang === "fr" ? frenchSpacing(md) : md);

// Footnotes called from the notice or a caption. They are written out with the
// same markup remark-gfm gives the prose's own footnotes, so one stylesheet
// serves both. The prose numbers its footnotes from 1 too, so a story may use
// one kind or the other.
const notes = story.data.notes;
if (notes.length && /^\[\^[^\]]+\]:/m.test(story.body ?? "")) {
  throw new Error(
    `${story.id}: footnotes in both the frontmatter and the prose would collide`
  );
}
const noteRef = (n: string) =>
  `<sup><a href="#user-content-fn-${n}" id="user-content-fnref-${n}" ` +
  `data-footnote-ref aria-describedby="footnote-label">${n}</a></sup>`;
const inline = (md: string) =>
  marked.parseInline(spaced(md).replace(/\[\^(\d+)\]/g, (_, n) => noteRef(n)));
---

<Base lang={lang} title={title} altHref={altHref}>
  <article class="story">
    <h1 class="story__title">{title}</h1>
    {spans.length > 0 && <span class="story__span sc">{spans.join(" · ")}</span>}

    {
      images.map((img) => (
        <figure class="story__figure">
          <img src={img.src} alt={img.alt} loading="lazy" />
          {img.caption && !placeholder && (
            <figcaption set:html={inline(img.caption)} />
          )}
        </figure>
      ))
    }

    {
      placeholder && (
        <p class="crosslang">
          {t.onlyInOther} <a href={altHref}>{t.read}</a>
        </p>
      )
    }

    {
      !placeholder && story.data.notice.length > 0 && (
        <div class="notice">
          {story.data.notice.map((row) => (
            <p class="notice__row">
              <span class="notice__label">{row.label}</span>
              <span class="notice__body" set:html={inline(row.body)} />
            </p>
          ))}
        </div>
      )
    }

    {!placeholder && (
    <div class="prose">
      <Content />
      {
        notes.length > 0 && (
          <section data-footnotes class="footnotes">
            <h2 id="footnote-label">{t.notes}</h2>
            <ol>
              {notes.map((note, i) => (
                <li id={`user-content-fn-${i + 1}`}>
                  <p>
                    <Fragment set:html={inline(note)} />{" "}
                    <a
                      href={`#user-content-fnref-${i + 1}`}
                      data-footnote-backref
                      class="data-footnote-backref"
                      aria-label={t.backToText}
                    >
                      ↩
                    </a>
                  </p>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </div>
    )}

    {!placeholder && (
    <footer class="story__foot">
      {
        story.data.source && (
          <p>
            {t.originally}{" "}
            <a href={story.data.source}>Cartographier tout et n’importe quoi</a>{", "}
            <span class="sc">
              {story.data.date.toLocaleDateString(lang, {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
          </p>
        )
      }
      {
        counterpart && (
          <p>
            <a href={altHref}>{t.otherLang}</a>
          </p>
        )
      }
    </footer>
    )}
  </article>
</Base>
